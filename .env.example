# NOXA Web 環境変数テンプレート
# `.env.local` にコピーして値を埋める。秘密値はコミットしないこと。
# 一覧は `grep -rhoE 'process\.env\.[A-Z0-9_]+' src | sed 's/process\.env\.//' | sort -u` と一致させる。
# NEXT_PUBLIC_* はクライアントへ露出する（秘密を入れない）。それ以外はサーバ専用。

# ── Firebase（クライアント公開・noxa-platform プロジェクト）──────────────
NEXT_PUBLIC_FIREBASE_API_KEY=              # Firebase Web API キー
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=          # 例: noxa-platform.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=           # noxa-platform
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=       # 例: noxa-platform.appspot.com（プロフィール画像用・Phase2）
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=  # FCM 送信者 ID
NEXT_PUBLIC_FIREBASE_APP_ID=               # Firebase アプリ ID
NEXT_PUBLIC_USE_EMULATOR=                  # 'true' で Firestore エミュレータへ接続（ローカル開発）

# ── Firebase Admin（サーバ専用・秘密）────────────────────────────────
FIREBASE_SERVICE_ACCOUNT_KEY=              # Admin SDK サービスアカウント JSON（1行文字列）。秘密

# ── Cloud Functions ───────────────────────────────────────────────
NEXT_PUBLIC_NOXA_FUNCTIONS_URL=            # asia-northeast1 の Functions ベース URL

# ── LINE ログイン ─────────────────────────────────────────────────
NEXT_PUBLIC_LINE_CHANNEL_ID=               # LINE Login チャネル ID（クライアント表示用）
LINE_LOGIN_CHANNEL_ID=                     # サーバ検証用チャネル ID
LINE_LOGIN_CHANNEL_SECRET=                 # LINE Login チャネルシークレット。秘密

# ── Google OAuth / Calendar 連携 ─────────────────────────────────
NEXT_PUBLIC_GOOGLE_CLIENT_ID=              # Google OAuth クライアント ID（クライアント）
GOOGLE_CLIENT_SECRET=                      # Google OAuth クライアントシークレット。秘密
CALENDAR_STATE_SECRET=                     # Calendar OAuth の state 署名鍵（CSRF 対策）。秘密
CALENDAR_ALLOW_LEGACY_STATE=               # 'true' で旧・無署名 state を後方互換許可（移行期のみ）

# ── AI（OpenRouter 経由）──────────────────────────────────────────
OPENROUTER_API_KEY=                        # OpenRouter API キー。秘密
OPENROUTER_HTTP_REFERER=                   # OpenRouter 送信元識別（任意・アプリ URL）
OPENROUTER_X_TITLE=                        # OpenRouter 表示タイトル（任意）
AI_PRIMARY_MODEL_FAST=                     # 高速用モデル ID（例: 低レイテンシ用）
AI_PRIMARY_MODEL_THINK=                    # 熟考用モデル ID（例: 高品質推論用）

# ── コミュニティ ──────────────────────────────────────────────────
NEXT_PUBLIC_COMMUNITY_BACKEND=             # コミュニティのバックエンド。既定=firestore（本番）。ローカルで実データに触らない場合のみ 'mock' を明示

# ── IAP: Apple ────────────────────────────────────────────────────
APPLE_IAP_BUNDLE_ID=                       # iOS アプリの Bundle ID（レシート検証照合用）

# ── IAP: Google Play ─────────────────────────────────────────────
GOOGLE_PLAY_PACKAGE_NAME=                  # Android パッケージ名
GOOGLE_PLAY_SERVICE_ACCOUNT_KEY=           # Play Developer API サービスアカウント JSON。秘密

# ── IAP: 共通ゲート（危険・要注意）────────────────────────────────
IAP_ALLOW_UNVERIFIED=                      # 'true' で未検証購入の grant を許可（非本番のみ有効。本番では NODE_ENV ガードで常に無効）

# ── ランタイム（フレームワーク管理・手動設定不要）──────────────────
NODE_ENV=                                  # Next.js が自動設定（development/production）。手動設定不要
